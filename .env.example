NODE_ENV=development
PORT=4021
HOST=127.0.0.1
# Use a dedicated production RPC provider; public endpoints are not production-grade.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional: set the full getGenesisHash value for the selected cluster.
SOLANA_EXPECTED_GENESIS_HASH=
# x402 v2. Use Devnet only for development. Do not use x402.org as a production facilitator.
X402_ENABLED=false
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_PAY_TO=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE_USD=$0.001
# Explicitly locked off in this codebase: no transaction signing/broadcast.
LIVE_TRADING_ENABLED=false
MAX_TRADE_USD=25
MAX_DAILY_LOSS_USD=50
MAX_SLIPPAGE_BPS=30
DEXSCREENER_BASE_URL=https://api.dexscreener.com
LOG_LEVEL=info
